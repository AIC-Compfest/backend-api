# Never commit real credentials. Copy this file to .env for local development.
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only by the server-side upload/worker flow introduced in Phase 4.
SUPABASE_SERVICE_ROLE_KEY=
AI_SERVICE_URL=http://localhost:8100
SCHEMA_VERSION=0.1.0
CONFIG_VERSION=0.1.0
WORKER_POLL_INTERVAL_SECONDS=5
# PDF OCR can exceed 35 seconds on CPU; keep this aligned with the client request budget.
AI_SERVICE_TIMEOUT_SECONDS=120
